# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode

START hilow_game

    # Establish a valid guessing range.
    DISPLAY "Welcome to the Higher/Lower Game!"
    REPEAT
        PROMPT "Enter the lower bound:" AND READ lower_bound
        PROMPT "Enter the upper bound:" AND READ upper_bound

        IF either bound is not an integer THEN
            DISPLAY "Enter integers for both bounds."
        ELSE IF lower_bound >= upper_bound THEN
            DISPLAY "The lower bound must be less than the upper bound."
        END IF
    UNTIL both bounds are integers AND lower_bound < upper_bound

    # Pick the secret number once.
    SET secret_number TO a random integer from lower_bound to upper_bound, inclusive
    SET guessed_correctly TO FALSE

    # Ask for a valid guess each time through the game loop.
    WHILE guessed_correctly = FALSE
        REPEAT
            DISPLAY "Guess a number from ", lower_bound, " to ", upper_bound, ":"
            INPUT guess

            IF guess is not an integer THEN
                DISPLAY "Enter an integer."
            ELSE IF guess < lower_bound OR guess > upper_bound THEN
                DISPLAY "Your guess must be within the range."
            END IF
        UNTIL guess is an integer AND lower_bound <= guess AND guess <= upper_bound

        IF guess < secret_number THEN
            DISPLAY "Nope, too low."
        ELSE IF guess > secret_number THEN
            DISPLAY "Nope, too high."
        ELSE
            DISPLAY "You got it!"
            SET guessed_correctly TO TRUE
        END IF
    END WHILE

END hilow_game



